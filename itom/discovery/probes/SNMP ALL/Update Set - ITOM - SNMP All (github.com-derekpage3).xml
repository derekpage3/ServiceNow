<name>discovery_sensor_aadd54060f922300e608b36be1050e1e</name>
<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="discovery_sensor"&gt;&lt;discovery_sensor action="INSERT_OR_UPDATE"&gt;&lt;active&gt;true&lt;/active&gt;&lt;agent/&gt;&lt;apply_defaults&gt;false&lt;/apply_defaults&gt;&lt;classification_type/&gt;&lt;coalesce/&gt;&lt;condition_script/&gt;&lt;data_option&gt;insert_update&lt;/data_option&gt;&lt;data_source/&gt;&lt;description&gt;SNMP - NULL&lt;/description&gt;&lt;external_names/&gt;&lt;java_class&gt;com.snc.discovery.sensor.snmp.Classify&lt;/java_class&gt;&lt;major_version&gt;1&lt;/major_version&gt;&lt;minor_version&gt;1&lt;/minor_version&gt;&lt;name&gt;SNMP - NULL&lt;/name&gt;&lt;order/&gt;&lt;parent/&gt;&lt;reacts_to_probe display_value="SNMP - ALL"&gt;2988010cdbe42b401a52ed384b96193f&lt;/reacts_to_probe&gt;&lt;script&gt;&lt;![CDATA[/**
 * @author github.com/derekpage3.
 *
 * This sensor is a companion to the "SNMP - ALL"
 * discovery probe and simply does nothing with the
 * payload returned by that probe. That probe is used
 * only for initial discovery of a new SNMP device
 * to determine what OIDs the device will return data
 * on and so we don't do anything with the data. Having
 * this sensor in place simply prevents discovery from
 * marking the return ECC Queue entry with a status of
 * "error"
 */
new DiscoverySensor({

    //do nothing with the payload.
    process: function() {},

    type: 'DiscoverySensor'
});]]&gt;&lt;/script&gt;&lt;sensor_type&gt;Javascript&lt;/sensor_type&gt;&lt;sys_class_name&gt;discovery_sensor&lt;/sys_class_name&gt;&lt;sys_created_by&gt;dpage@contendersolutions.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2018-12-11 22:15:42&lt;/sys_created_on&gt;&lt;sys_id&gt;aadd54060f922300e608b36be1050e1e&lt;/sys_id&gt;&lt;sys_mod_count&gt;3&lt;/sys_mod_count&gt;&lt;sys_name&gt;SNMP - NULL&lt;/sys_name&gt;&lt;sys_package display_value="Global" source="global"&gt;global&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="Global"&gt;global&lt;/sys_scope&gt;&lt;sys_update_name&gt;discovery_sensor_aadd54060f922300e608b36be1050e1e&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-03-10 20:32:31&lt;/sys_updated_on&gt;&lt;table/&gt;&lt;type&gt;excel&lt;/type&gt;&lt;xml_root_node/&gt;&lt;/discovery_sensor&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;aadd54060f922300e608b36be1050e1e&lt;/id&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-03-10 20:32:31&lt;/sys_created_on&gt;&lt;sys_id&gt;21f4a26983a3321095daccb6feaad30d&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-03-10 20:32:31&lt;/sys_updated_on&gt;&lt;table&gt;discovery_sensor&lt;/table&gt;&lt;use_es_latest&gt;false&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
