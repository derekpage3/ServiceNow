<name>discovery_sensor_29c95efb0ff49600b1264d9ce1050e30</name>
<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="discovery_sensor"&gt;&lt;discovery_sensor action="INSERT_OR_UPDATE"&gt;&lt;active&gt;true&lt;/active&gt;&lt;agent/&gt;&lt;apply_defaults&gt;true&lt;/apply_defaults&gt;&lt;classification_type/&gt;&lt;coalesce/&gt;&lt;condition_script/&gt;&lt;data_option&gt;insert_update&lt;/data_option&gt;&lt;data_source/&gt;&lt;description&gt;Process information for Cisco Firewalls&lt;/description&gt;&lt;external_names/&gt;&lt;java_class/&gt;&lt;major_version&gt;1&lt;/major_version&gt;&lt;minor_version&gt;0&lt;/minor_version&gt;&lt;name&gt;SNMP - Cisco Firewall (CS)&lt;/name&gt;&lt;order/&gt;&lt;parent/&gt;&lt;reacts_to_probe display_value="SNMP - Cisco Firewall (CS)"&gt;e989dafb0ff49600b1264d9ce1050e51&lt;/reacts_to_probe&gt;&lt;script&gt;&lt;![CDATA[new DiscoverySensor({
    process: function(result) {	
		this.ciData = new CIData();
		this.ciData.fromXML(this.getParameter('cidata'));
		this.ci_data = this.ciData.getData();
		
		var snmp = new SNMPResponse(result);
		var capabilities = {};
		if (g_device) {
		   var status = new DiscoveryStatus('' + g_device.getStatus());
		   capabilities['discover'] = status.discover;
		}
		var props = {};	
		
		this.analyze(snmp, capabilities, props);
    },  
	
	analyze: function(snmp, capabilities, props) {
		
		//get standard entityMIB firmware attribute.  If non-null then set it in the firmware version field.
		var firmwareVersion = snmp.getOIDText("iso.org.dod.internet.mgmt.mib-2.entityMIB.entityMIBObjects.entityPhysical.entPhysicalTable.entPhysicalEntry.entPhysicalFirmwareRev");
		if (JSUtil.notNil(firmwareVersion)) {
			
			//get the parent WAP Controller CI 
			var firewall = new GlideRecord("cmdb_ci_ip_firewall");		
			firewall.addQuery("ip_address", snmp.snmp['@ip']);
			firewall.query();
			//if not found then quit.  This should already exist since we're in exploration phase.
			if (!firewall.next()) {
				//log that the CI wasn't found and return.
				this.handleError([("Unable to find the CI for the Firewall at IP " + snmp.snmp['@ip'])]);
				return;
			}
			
			firewall.firmware_version = firmwareVersion;
			firewall.update();
		}
    },
    
    type: 'DiscoverySensor'
});
]]&gt;&lt;/script&gt;&lt;sensor_type&gt;Javascript&lt;/sensor_type&gt;&lt;sys_class_name&gt;discovery_sensor&lt;/sys_class_name&gt;&lt;sys_created_by&gt;dpage@contendersolutions.com&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2016-01-13 23:16:54&lt;/sys_created_on&gt;&lt;sys_customer_update&gt;true&lt;/sys_customer_update&gt;&lt;sys_id&gt;29c95efb0ff49600b1264d9ce1050e30&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_name&gt;SNMP - Cisco Firewall (CS)&lt;/sys_name&gt;&lt;sys_package display_value="Global" source="global"&gt;global&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_replace_on_upgrade&gt;false&lt;/sys_replace_on_upgrade&gt;&lt;sys_scope display_value="Global"&gt;global&lt;/sys_scope&gt;&lt;sys_update_name&gt;discovery_sensor_29c95efb0ff49600b1264d9ce1050e30&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;dpage@contendersolutions.com&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2016-01-13 23:16:54&lt;/sys_updated_on&gt;&lt;table/&gt;&lt;type&gt;data_source&lt;/type&gt;&lt;xml_root_node/&gt;&lt;/discovery_sensor&gt;&lt;/record_update&gt;</payload>
